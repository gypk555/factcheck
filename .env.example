# Copy to .env (never commit .env). Both settings are optional.

# Enables the "Published fact-checks" panel. Free key:
# https://developers.google.com/fact-check/tools/api  (enable "Fact Check Tools API" in Google Cloud)
GOOGLE_FACTCHECK_API_KEY=

# Max fact-check look-ups per visitor per minute
FACTCHECK_RATE_LIMIT_PER_MIN=20
